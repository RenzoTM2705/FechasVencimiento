# ============================================================
# FechasVencimiento — variables de entorno del cliente
# ============================================================
# Copia este archivo a `.env.local` y completa los valores reales.
# `.env.local` está ignorado por Git: nunca subas claves reales.
#
# Estas dos variables SÍ se incluyen en el bundle del navegador:
# son públicas por diseño. La seguridad de los datos depende de
# Row Level Security (RLS) en Supabase, no de ocultar la anon key.
#
# NUNCA uses aquí la `service_role` key: omite RLS y da acceso total.
# ============================================================

# URL del proyecto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave pública `anon` de Supabase (Project Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REEMPLAZAR.CON_LA_CLAVE_ANON_REAL
